# ---------------------------------------------------------------------------
# LLM Provider — choose ONE (no payment method needed for groq or gemini)
# ---------------------------------------------------------------------------
# Options: groq | gemini | openai
LLM_PROVIDER=groq

# Groq — FREE, recommended (sign up at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini — FREE (get key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# OpenAI — requires billing/credits (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
